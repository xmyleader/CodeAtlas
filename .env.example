# Replace every value before loading this file. CodeAtlas does not auto-load .env.
CODEATLAS_ENDPOINT=https://provider.example/v1/chat/completions
CODEATLAS_MODEL=replace-with-tool-capable-model
CODEATLAS_API_KEY=replace-with-api-key

# Optional settings can be added as needed; see README.md and GUIDE.md.
# CODEATLAS_DATA_DIR=/absolute/path/outside/the/repository
# CODEATLAS_REASONING_MODE=replace-with-provider-reasoning-mode
# CODEATLAS_REASONING_EFFORT=replace-with-provider-reasoning-effort
# CODEATLAS_MODEL_TIMEOUT_SECONDS=replace-with-seconds
# CODEATLAS_AGENT_TIMEOUT_SECONDS=replace-with-seconds
# CODEATLAS_MODEL_MAX_RETRIES=replace-with-count
# CODEATLAS_GATEWAY_MAX_RETRIES=replace-with-count
# CODEATLAS_MAX_OUTPUT_TOKENS=replace-with-token-count
# CODEATLAS_CONTEXT_WINDOW_TOKENS=replace-with-token-count
# CODEATLAS_TEMPERATURE=replace-with-temperature
# CODEATLAS_PRICING_CURRENCY=replace-with-currency-code
# CODEATLAS_INPUT_PRICE_PER_MILLION=replace-with-rate
# CODEATLAS_CACHED_INPUT_PRICE_PER_MILLION=replace-with-rate
# CODEATLAS_OUTPUT_PRICE_PER_MILLION=replace-with-rate
# CODEATLAS_AGENT_MAX_TOTAL_TOKENS=replace-with-token-count
# CODEATLAS_AGENT_MAX_COST=replace-with-amount
